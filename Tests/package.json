{
  "name": "rox-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Rox Lab: the test agent, its sandbox and its checks. Runs with the agent package's tools (tsx, Temporal).",
  "scripts": {
    "image": "docker build -t rox-sandbox:1 sandbox",
    "viewer": "pnpm --dir ../agent exec tsx ../Tests/src/viewer.ts",
    "proof:isolation": "pnpm --dir ../agent exec tsx ../Tests/src/proof-isolation.ts",
    "typecheck": "pnpm --dir ../agent exec tsc --noEmit -p ../Tests"
  }
}
