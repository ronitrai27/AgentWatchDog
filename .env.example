# Copy to .env and fill in. Never commit .env.

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Any long random string; must match the webhook secret set on the GitHub App
GITHUB_APP_WEBHOOK_SECRET=
# Path to the downloaded private key. Keep it outside git (secrets/ is ignored)
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/rox-github-app.pem

# Dev only: public relay that forwards GitHub webhooks to your laptop
SMEE_URL=

# Web app
APP_URL=http://localhost:3000
GITHUB_APP_SLUG=rox-watchdog
# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Postgres (Docker). Owner runs migrations and backups; app is what the services use.
POSTGRES_USER=rox_owner
POSTGRES_PASSWORD=
POSTGRES_DB=rox
ROX_APP_DB_PASSWORD=
DATABASE_OWNER_URL=postgres://rox_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/rox
DATABASE_URL=postgres://rox_app:<ROX_APP_DB_PASSWORD>@127.0.0.1:5432/rox
# Optional: a second folder for backup copies (another drive, OneDrive, a mounted bucket)
BACKUP_COPY_DIR=

# The agent connects as its own database role (rox_agent). Unlike the web role it can
# read stored model keys and write chat events. It uses the same host and database as DATABASE_URL.
ROX_AGENT_DB_PASSWORD=
# Encrypts stored API keys (AES-256-GCM), 64 hex characters. Losing it makes saved keys unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional: Groq writes the one-line summary on Home
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Slack App (Rox notifications & @rox mentions)
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_REPORT_CHANNEL_ID=

# Sentry (wakes Rox on new issues, error spikes, regressions)
# Sentry > Settings > Developer Settings > Custom Integrations > New Internal Integration.
# Permissions: Project Read, Issue & Event Read. Webhooks: tick "issue"; turn on "Alert Rule Action".
# Its token:
SENTRY_AUTH_TOKEN=
# The organisation slug, e.g. vrsa-solution-6q
SENTRY_ORG=
# https://sentry.io, or https://de.sentry.io for EU-region organisations
SENTRY_URL=https://sentry.io
# The integration's Client Secret: checks the signature on every webhook
SENTRY_CLIENT_SECRET=
# Dev only: a separate smee.io channel; set it as the integration's Webhook URL
SENTRY_SMEE_URL=
